# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.

ANTHROPIC_API_KEY=sk-ant-...

# SQL Server connection (Windows Auth — leave SQL_USER/SQL_PASS blank)
# Or SQL Auth — fill in SQL_USER and SQL_PASS
SQL_SERVER=.\SQLEXPRESS
SQL_DATABASE=BI_POC
SQL_USER=
SQL_PASS=

# Agent settings
AGENT_MODEL=claude-opus-4-6
DATA_DIR=data/raw
OUTPUT_DIR=output
